{
  "name": "cli-commentator",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "claude:setup-hooks": "node ./scripts/setup-claude-hooks.mjs",
    "dev:claude:file": "node ./scripts/dev-claude-file.mjs",
    "dev:codex:file": "node ./scripts/dev-codex-file.mjs",
    "postinstall": "node ./scripts/fix-node-pty-permissions.mjs",
    "dev": "concurrently -n server,web \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "dev:server": "pnpm -C apps/server dev",
    "dev:web": "pnpm -C apps/web dev",
    "dev:desktop": "concurrently -n server,web,tauri \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\" \"wait-on http://localhost:5173 tcp:localhost:8787 && pnpm -C apps/desktop tauri:dev\"",
    "dev:desktop:managed": "pnpm ensure:desktop-sidecar && concurrently -n web,tauri \"pnpm -C apps/web dev\" \"wait-on http://localhost:5173 && pnpm -C apps/desktop tauri:dev\"",
    "build:server": "pnpm -C apps/server build",
    "ensure:desktop-sidecar": "node ./scripts/ensure-desktop-sidecar-prepared.mjs",
    "prepare:desktop-sidecar": "node ./scripts/prepare-desktop-sidecar.mjs",
    "build:sidecar": "pnpm prepare:desktop-sidecar",
    "check:doc-sync": "node ./scripts/check-doc-sync.mjs",
    "smoke:desktop-distribution": "node ./scripts/desktop-distribution-smoke.mjs",
    "smoke:llm": "bash ./scripts/smoke-llm.sh",
    "verify:apple-signing:detect": "node ./scripts/verify-apple-signing-secrets.mjs --mode detect",
    "verify:apple-signing": "node ./scripts/verify-apple-signing-secrets.mjs --mode require",
    "verify:desktop-bundle-artifacts": "node ./scripts/verify-desktop-bundle-artifacts.mjs",
    "verify:internal-release": "node ./scripts/verify-internal-release-readiness.mjs",
    "verify:release-token": "node ./scripts/verify-release-token-permissions.mjs --mode require-write",
    "verify:updater": "node ./scripts/verify-updater-config.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "plist": "^5.0.0",
    "tar": "^7.5.15",
    "wait-on": "^9.0.6"
  }
}
