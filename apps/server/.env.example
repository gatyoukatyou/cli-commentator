# Server port (primary key used by desktop/web)
CLI_COMMENTATOR_PORT=8787
# Backward-compatible fallback if CLI_COMMENTATOR_PORT is not set
# PORT=8787

# Input mode: pty|file (default: pty)
# INPUT_MODE=pty
# Required when INPUT_MODE=file, optional fallback when INPUT_MODE=pty
# INPUT_FILE=/path/to/your-app.log

TARGET_CMD=bash
TARGET_ARGS=
# TARGET_ARGS_JSON=["status","-sb"]
TARGET_CWD=

# Windows debugging helper (optional)
# PTY_USE_CONPTY=1
# Force-disable PTY to test file fallback behavior (optional)
# CLI_COMMENTATOR_FORCE_NO_PTY=1
# Diagnostic only: records unredacted PTY chunks as timestamped Base64 JSONL.
# The file can contain secrets and local paths; keep it outside the repository and sanitize before sharing.
# PTY_CAPTURE_FILE=/tmp/session.pty-capture.jsonl

# Which ruleset to use: auto|claude|codex|generic
LOG_SOURCE=auto

# LLM settings
# LLM_PROVIDER=disabled
# MOCK_LLM_MODE=
# OpenCode Go (when LLM_PROVIDER=opencode-go)
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=deepseek-v4-flash

# Timeout settings (ms)
# COMMENT_TIMEOUT_MS=3000        # Timeout for individual comment() calls
# COMMENT_EXIT_TIMEOUT_MS=1500   # Hard timeout for exit event cleanup
# SILENCE_TIMEOUT_MS=60000       # Emit one silence event after this period without PTY/file output
