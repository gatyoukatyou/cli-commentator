{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLI Commentator",
  "version": "0.2.2",
  "identifier": "com.cli-commentator.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CLI Commentator",
        "width": 1024,
        "height": 768,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "resources": [
      "binaries",
      "resources/server",
      "resources/sidecar-manifest.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFREI5Rjk1REI1M0Y5RkEKUldUNitWUGJsWi9iRGk3cDN0YzdvcW45T1h1RXZ4QnBpVnhwYnduZkdLWjRIMHpmamhrR2ZaL3gK",
      "endpoints": [
        "https://github.com/gatyoukatyou/cli-commentator/releases/latest/download/latest.json"
      ]
    }
  }
}
